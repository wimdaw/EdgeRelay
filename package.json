{
  "name": "edgerelay-edgeone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "部署在腾讯云 EdgeOne Pages + Blob 数据库上的合规 AI API 网关 (OpenAI 兼容接口)",
  "main": "cloud-functions/[[default]].js",
  "scripts": {
    "build:assets": "node scripts/build-assets.mjs",
    "build:bundle": "node scripts/build-bundle.mjs",
    "build": "npm run build:assets && npm run build:bundle",
    "deploy": "npm run build && edgeone makers deploy --json",
    "test": "node tests/test-runner.mjs"
  },
  "dependencies": {
    "@edgeone/pages-blob": "^0.0.17",
    "hono": "^4.12.27"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "edgeone": "^1.6.41",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2"
  }
}
