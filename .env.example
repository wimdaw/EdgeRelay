# EdgeRelay (EdgeOne Pages) 环境变量示例

# 1. 密钥材料（必填）
ENCRYPTION_KEY=your-32-byte-random-secret-for-aes-256-gcm
SESSION_SECRET=your-32-byte-random-secret-for-session-cookies

# 2. EdgeOne Blob 凭据（在 EdgeOne 云函数环境中通常自动注入；本地测试或外部调用可填）
# EDGEONE_TOKEN_NEW=your-pages-api-token
# BLOB_STORE_NAME=edgerelay-db

# 3. 平台可选配置
# CORS_ORIGINS=https://your-domain.com,http://localhost:5173
# MODERATION_API_URL=https://your-moderation-api.com/v1/moderate
