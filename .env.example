# EdgeRelay (EdgeOne Pages) 环境变量示例

# 1. 密钥材料（必填）
ENCRYPTION_KEY=your-32-byte-random-secret-for-aes-256-gcm
SESSION_SECRET=your-32-byte-random-secret-for-session-cookies

# 2. EdgeOne Blob 凭据（在 EdgeOne 云函数环境中通常自动注入；本地测试或外部调用可填）
# EDGEONE_TOKEN_NEW=your-pages-api-token
# BLOB_STORE_NAME=edgerelay-db

# 3. 平台可选配置
# CORS_ORIGINS=https://your-domain.com,http://localhost:5173
# MODERATION_API_URL=https://your-moderation-api.com/v1/moderate

# 4. Trae 双区渠道（可选覆盖；不填走内置默认端点）
# 4.1 数据面（对话 /api/ide/v1/llm_raw_chat、模型目录 /api/ide/v1/model_list）
# TRAE_CN_CORE_URL=https://trae-api-cn.mchost.guru
# TRAE_GLOBAL_CORE_URL=https://core-normal.traeapi.us
# 4.2 账号面（OAuth 换票 /cloudide/api/v3/trae/oauth/ExchangeToken、GetUserInfo）
# TRAE_CN_ACCOUNT_URL=https://api.trae.com.cn
# TRAE_GLOBAL_ACCOUNT_URL=https://grow-normal.trae.ai
# 4.3 授权 client_id（两区默认相同；上游换 client 时无需改代码）
# TRAE_CLIENT_ID=ono9krqynydwx5
# TRAE_CN_CLIENT_ID=
# TRAE_GLOBAL_CLIENT_ID=

# 说明：Trae 的区域由「渠道 Base URL」决定，不需要在这里选区域：
#   国内版 -> https://trae-api-cn.mchost.guru
#   国际版 -> https://core-normal.traeapi.us
